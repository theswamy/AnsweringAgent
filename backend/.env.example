# Copy to .env and fill in. Never commit the real .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Most capable default. For lower latency on live calls you may use claude-haiku-4-5.
CLAUDE_MODEL=claude-opus-4-8

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# The Twilio number your phone forwards to (E.164).
TWILIO_PHONE_NUMBER=+14155550123

# --- App ---
# Public HTTPS URL Twilio can reach (e.g. your ngrok or deployed URL). No trailing slash.
PUBLIC_BASE_URL=https://your-server.example.com
# Shared secret the iPhone app sends as X-API-Key. Use a long random string.
APP_API_KEY=generate-a-long-random-string
DATABASE_PATH=answering_agent.db

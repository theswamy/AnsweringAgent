# Copy to .env and fill in. Everything here is optional for the offline demo.

# --- Anthropic (writes the episode summaries) ---
# Without a key, the digest still builds — it just echoes trimmed show notes
# instead of Claude-written summaries.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# --- Email delivery (SMTP) ---
# Gmail example: host smtp.gmail.com, port 587, username your address, password
# an app password (https://myaccount.google.com/apppasswords). Or use SendGrid,
# SES, Postmark — any SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=sanjay@primevp.in

# If true (or if SMTP is blank) the digest is written to ./outbox/ instead of sent.
DRY_RUN=false

# --- Sourcing ---
COUNTRY=us
TOP_N=10
SUMMARIZE_TOP_LIST=false

# --- Daily schedule (used by the in-process scheduler) ---
SEND_HOUR=7
TIMEZONE=Asia/Kolkata

# --- Storage ---
DATABASE_PATH=podcast_digest.db
